{
  "name": "postbox",
  "version": "0.1.0",
  "description": "Drop everything you make into one folder. It organises, proposes posts, plans the grid, and (eventually) posts for you.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "ingest": "node server/ingest.js",
    "harvest": "node tools/harvest.mjs",
    "shoot": "node tools/screenshot.mjs",
    "test": "node tests/run.mjs && node tests/hands.mjs",
    "smoke": "node tests/drive.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "sharp": "^0.35.4",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
