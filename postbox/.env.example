# Copy to .env. Every key is optional; without it the matching feature falls back or is disabled.
ANTHROPIC_API_KEY=            # analysis, captions, proposals, grid reasoning
POSTBOX_MODEL=claude-opus-5   # override the model for text/vision work
OPENAI_API_KEY=               # gpt-image cover generation (generators/openai-image.js)
GEMINI_API_KEY=               # Gemini image generation (generators/gemini-image.js)
SUNO_API_KEY=                 # theme music (generators/suno.js)
TRIPO_API_KEY=                # text/image -> 3D (generators/tripo.js)
POSTBOX_PORT=8140
DISCORD_WEBHOOK_URL=          # the handoff: finished posts land in this channel
POSTBOX_AUTO_THRESHOLD=0.85   # auto mode approves proposals at or above this confidence
POSTBOX_AUTO_HANDOFF=0        # 1 lets auto mode hand approved posts to Discord
